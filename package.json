{
  "name": "n3com",
  "productName": "N3com",
  "version": "1.0.0",
  "description": "Gestión local de torneos NEWCOM.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "web": "node server.js",
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.n3com.desktop",
    "productName": "N3com",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!private/**",
      "!release/**",
      "!tests/**",
      "!.kilo/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets"
    },
    "mac": {
      "icon": "assets/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
